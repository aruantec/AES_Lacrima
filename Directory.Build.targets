<Project>
  <!-- .NET SDK 10 can leave literal ** globs in default item groups for projects with no matching files. -->
  <Target Name="ClearLiteralAvaloniaXamlGlobs" BeforeTargets="GenerateAvaloniaResources">
    <ItemGroup>
      <AvaloniaXaml Remove="@(AvaloniaXaml)"
                    Condition="$([System.String]::Copy('%(Identity)').Contains('*'))" />
    </ItemGroup>
  </Target>

  <Target Name="ClearLiteralEmbeddedResourceGlobs" BeforeTargets="CoreResGen">
    <ItemGroup>
      <EmbeddedResource Remove="@(EmbeddedResource)"
                        Condition="$([System.String]::Copy('%(Identity)').Contains('*'))" />
    </ItemGroup>
  </Target>

  <!-- Avalonia build telemetry can fail when ~/.local/share/AvaloniaUI is not writable. -->
  <Target Name="AvaloniaStats" />

</Project>
