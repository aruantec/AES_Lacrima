<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <LangVersion>13</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <PropertyGroup>
        <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Autofac" Version="9.0.0" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="log4net" Version="3.3.0" />
    </ItemGroup>

    <!-- Restore-only link: generator is built via BuildAesDiGenerator, not as a compile reference.
         Omit during AOT restore — netstandard2.0 cannot participate in Native AOT. -->
    <ItemGroup Condition="'$(PublishAot)' != 'true'">
      <ProjectReference Include="..\AES_Di.Generator\AES_Di.Generator.csproj">
        <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        <BuildReference>false</BuildReference>
      </ProjectReference>
    </ItemGroup>

    <ItemGroup>
      <Analyzer Include="..\AES_Di.Generator\obj\$(Configuration)\netstandard2.0\AES_Di.Generator.dll" />
    </ItemGroup>

    <Target Name="BuildAesDiGenerator"
            BeforeTargets="CoreCompile">
        <MSBuild Projects="..\AES_Di.Generator\AES_Di.Generator.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
    </Target>
</Project>
