<Project>
  <PropertyGroup>
    <AvaloniaVersion>12.1.0</AvaloniaVersion>
    <SvgControlsSkiaAvaloniaVersion>12.0.0.13</SvgControlsSkiaAvaloniaVersion>
    <XamlBehaviorsVersion>12.0.5</XamlBehaviorsVersion>
    <!-- Ensure linker incremental linking is enabled for Debug builds -->
    <LinkIncremental>true</LinkIncremental>
    <!-- Ignore missing optional machine-local NuGet feeds during restore. -->
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <!-- Avoid intermittent csc exit 139 (compiler-server segfault) on Linux. -->
    <UseSharedCompilation>false</UseSharedCompilation>
    <DisableBuildServer>true</DisableBuildServer>
    <!-- DATAS GC mode is linked to intermittent Roslyn crashes on Linux (dotnet/runtime#104123). -->
    <GarbageCollectionAdaptationMode Condition="'$(OS)' != 'Windows_NT'">0</GarbageCollectionAdaptationMode>
    <!-- CscEnvironment disables DATAS GC for the Roslyn host on Linux (dotnet/runtime#104123). -->
    <CscEnvironment Condition="'$(OS)' != 'Windows_NT'">DOTNET_GCDynamicAdaptationMode=0;DOTNET_GCServer=0;DOTNET_ReadyToRun=0</CscEnvironment>
    <!-- Serialize project builds on Linux to reduce parallel csc pressure. -->
    <BuildInParallel Condition="'$(OS)' != 'Windows_NT' and '$(Configuration)' == 'Debug'">false</BuildInParallel>
    <MaxCpuCount Condition="'$(OS)' != 'Windows_NT' and '$(Configuration)' == 'Debug'">1</MaxCpuCount>
    <!-- Skip analyzers during Debug builds on Linux to reduce Roslyn memory pressure. -->
    <RunAnalyzers Condition="'$(OS)' != 'Windows_NT' and '$(Configuration)' == 'Debug'">false</RunAnalyzers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_AOT</DefineConstants>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <!-- Force /Zi (Program Database) instead of /ZI (Edit-and-Continue) so the compiler does not emit /EDITANDCONTINUE -->
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <!-- Ensure linker incremental linking is enabled at the Link item level as well -->
      <LinkIncremental>true</LinkIncremental>
    </Link>
  </ItemDefinitionGroup>
</Project>
