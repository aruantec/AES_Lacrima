<Project>
  <PropertyGroup>
    <!-- Ensure linker incremental linking is enabled for Debug builds -->
    <LinkIncremental>true</LinkIncremental>
    <!-- Ignore missing optional machine-local NuGet feeds during restore. -->
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <!-- Avoid intermittent csc exit 139 (compiler-server segfault) on Linux. -->
    <UseSharedCompilation>false</UseSharedCompilation>
    <DisableBuildServer>true</DisableBuildServer>
    <!-- DATAS GC mode is linked to intermittent Roslyn crashes on Linux (dotnet/runtime#104123). -->
    <GarbageCollectionAdaptationMode Condition="'$(OS)' != 'Windows_NT'">0</GarbageCollectionAdaptationMode>
    <!-- Serialize project builds on Linux to reduce parallel csc pressure. -->
    <BuildInParallel Condition="'$(OS)' != 'Windows_NT' and '$(Configuration)' == 'Debug'">false</BuildInParallel>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <!-- Force /Zi (Program Database) instead of /ZI (Edit-and-Continue) so the compiler does not emit /EDITANDCONTINUE -->
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <!-- Ensure linker incremental linking is enabled at the Link item level as well -->
      <LinkIncremental>true</LinkIncremental>
    </Link>
  </ItemDefinitionGroup>
</Project>
