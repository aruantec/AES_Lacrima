<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AES_Lacrima.ViewModels"
             xmlns:controls="using:AES_Controls"
             x:Class="AES_Lacrima.DolphinCheatsOverlay"
             x:Name="DolphinCheatsOverlayRoot"
             x:DataType="vm:DolphinCheatsEditorViewModel"
             IsHitTestVisible="{Binding IsOpen}"
             Opacity="{Binding IsOpen, Converter={StaticResource BoolToOpacityConverter}}">

    <UserControl.Transitions>
        <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.32" />
        </Transitions>
    </UserControl.Transitions>

    <Grid Background="#E6000000">
        <Grid RowDefinitions="Auto,*,Auto" Margin="24,16,24,20">
            <StackPanel Grid.Row="0" Spacing="4" Margin="6,0,0,12">
                <TextBlock Text="{Binding OverlayHeader}"
                           FontSize="42"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="Game ID" Foreground="#D8D8D8" FontSize="20" />
                    <TextBlock Text="{Binding GameIdDisplay, FallbackValue=Unknown, TargetNullValue=Unknown}"
                               Foreground="White"
                               FontSize="20" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#1AFFFFFF"
                    BorderBrush="#3FFFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <controls:LoadingControl Width="72"
                                             Height="72"
                                             Foreground="#FFFFFFFF"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding IsBusy}" />

                    <Grid RowDefinitions="Auto,*" RowSpacing="10" IsVisible="{Binding !IsBusy}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                            <ComboBox ItemsSource="{Binding KindFilterOptions}"
                                      SelectedItem="{Binding SelectedKindFilter, Mode=TwoWay}"
                                      MinWidth="180"
                                      VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Content="Download Gecko Codes"
                                    Command="{Binding DownloadGeckoCodesCommand}"
                                    IsEnabled="{Binding CanDownloadGeckoCodes}"
                                    Padding="12,6" />
                            <Button Grid.Column="3"
                                    Content="Enable All"
                                    Command="{Binding SelectAllCheatsCommand}"
                                    Padding="12,6" />
                            <Button Grid.Column="4"
                                    Content="Disable All"
                                    Command="{Binding UnselectAllCheatsCommand}"
                                    Padding="12,6" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredCheatEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DolphinCheatEntryViewModel">
                                        <Border Background="#14000000"
                                                BorderBrush="#33FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="White"
                                                                   FontSize="20"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding KindLabel}"
                                                                   Foreground="#888888"
                                                                   FontSize="16"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding LineCount, StringFormat='{}{0} line(s)'}"
                                                               Foreground="#B0B0B0"
                                                               FontSize="15" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="6,12,0,0">
                <TextBlock Grid.Column="0"
                           Text="{Binding Status}"
                           Foreground="#D8D8D8"
                           FontSize="18"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Close"
                        Command="{Binding CloseCommand}"
                        Padding="14,8" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
